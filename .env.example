# Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Database and application protection
DATABASE_URL=
ARCJET_KEY=
# HMAC secret used to make rate-limit identities opaque. Use a stable random
# value shared by every application instance; rotate deliberately.
RATE_LIMIT_KEY_SECRET=

# Public URL used in workspace invitation links.
# Use http://localhost:3000 locally and your canonical HTTPS URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional transactional email delivery for workspace invitations (Resend).
# RESEND_FROM_EMAIL must use a domain verified in your Resend account.
RESEND_API_KEY=
RESEND_FROM_EMAIL="LeadFlow <team@your-domain.com>"
