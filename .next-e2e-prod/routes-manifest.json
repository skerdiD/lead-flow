      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/dashboard/accounts",
      "destination": "/dashboard/customers/accounts",
      "statusCode": 307,
      "regex": "^(?!/_next)/dashboard/accounts(?:/)?$"
    },
    {
      "source": "/dashboard/accounts/:path*",
      "destination": "/dashboard/customers/accounts/:path*",
      "statusCode": 307,
      "regex": "^(?!/_next)/dashboard/accounts(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
